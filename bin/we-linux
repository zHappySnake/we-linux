#!/usr/bin/env bash
# we-linux: run the Steam copy of Wallpaper Engine under Proton as a desktop wallpaper.
#
# Usage:
#   Steam launch option:  /path/to/we-linux %command%
#   Standalone (dev):     we-linux            # launches through Proton itself
#
# Environment:
#   WE_LINUX_DEBUG=1      enable Proton/Wine logging into ./logs (or $WE_LINUX_LOGDIR)
#   WE_LINUX_PROTON=name  Proton directory under steamapps/common (default: Proton - Experimental)
set -euo pipefail

APPID=431960
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STEAM_ROOT="${STEAM_ROOT:-$HOME/.local/share/Steam}"

log() { printf '[we-linux] %s\n' "$*" >&2; }

# Locate the library folder that holds Wallpaper Engine.
find_library() {
    local vdf="$STEAM_ROOT/steamapps/libraryfolders.vdf" lib
    while read -r lib; do
        if [[ -f "$lib/steamapps/appmanifest_$APPID.acf" ]]; then
            printf '%s\n' "$lib"
            return 0
        fi
    done < <(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"/\1/p' "$vdf")
    return 1
}

LIBRARY="$(find_library)" || { log "Wallpaper Engine (app $APPID) is not installed through Steam."; exit 1; }
WE_DIR="$LIBRARY/steamapps/common/wallpaper_engine"
COMPAT_DATA="$LIBRARY/steamapps/compatdata/$APPID"

if [[ "${WE_LINUX_DEBUG:-0}" == 1 ]]; then
    LOGDIR="${WE_LINUX_LOGDIR:-$ROOT/logs}"
    mkdir -p "$LOGDIR"
    export PROTON_LOG=1 PROTON_LOG_DIR="$LOGDIR"
    export WINEDEBUG="${WINEDEBUG:-+seh,+loaddll,err+all,warn+win}"
    export WE_LINUX_SHIM_LOG="Z:${LOGDIR//\//\\}"
    log "debug logging to $LOGDIR"
fi

DESKTOP_TITLE="Wallpaper Engine Desktop"   # must match DESKTOP_TITLE in shim/weshim.c

# KDE: a forced window rule keeps the desktop window borderless and below all other windows.
# "Force" also makes KWin ignore Wine's fullscreen request, which would otherwise put the window
# above everything, panels included. The KWin script sizes it to span every monitor.
setup_kwin() {
    local rc=kwinrulesrc g=we-linux-desktop rules qdbus key
    command -v kwriteconfig6 >/dev/null && command -v kreadconfig6 >/dev/null || { log "kwriteconfig6 not found"; return 1; }
    qdbus="$(command -v qdbus6 || command -v qdbus)" || { log "qdbus not found"; return 1; }

    set_rule() { kwriteconfig6 --file "$rc" --group "$g" --key "$1" -- "$2"; }
    set_rule Description "Wallpaper Engine desktop (we-linux)"
    set_rule wmclass steam_app_$APPID;    set_rule wmclassmatch 1; set_rule wmclasscomplete false
    set_rule title "$DESKTOP_TITLE";      set_rule titlematch 1
    for key in below noborder skiptaskbar skippager skipswitcher; do set_rule "$key" true; set_rule "${key}rule" 2; done
    for key in fullscreen above acceptfocus; do set_rule "$key" false; set_rule "${key}rule" 2; done
    # Older versions forced a fixed geometry here.
    for key in position positionrule size sizerule; do kwriteconfig6 --file "$rc" --group "$g" --key "$key" --delete; done

    rules="$(kreadconfig6 --file "$rc" --group General --key rules)"
    [[ ",$rules," == *",$g,"* ]] || kwriteconfig6 --file "$rc" --group General --key rules -- "${rules:+$rules,}$g"
    "$qdbus" org.kde.KWin /KWin reconfigure >/dev/null

    "$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript we-desktop >/dev/null 2>&1 || true
    "$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$ROOT/kwin/we-desktop.js" we-desktop >/dev/null &&
        "$qdbus" org.kde.KWin /Scripting org.kde.kwin.Scripting.start >/dev/null || { log "could not load the KWin script"; return 1; }
    log "KWin rule and script installed"
}

# The Wine process itself: its command line starts with the executable's path. Our own processes
# (and Steam's wrappers) only mention wallpaper64.exe further along, so they must not match.
WE_PROCESS='^[^ ]*[/\\]wallpaper64\.exe( |$)'
we_running() { pgrep -f "$WE_PROCESS" >/dev/null; }

# Safety net (second line behind the KWin script's): if the desktop window isn't kept below, it covers
# every other window, so stop Wallpaper Engine instead of leaving the user stuck behind it.
# _NET_WM_STATE_FULLSCREEN alone isn't checked: Wine sets it before mapping and KWin leaves it there
# even though the forced rule keeps the window out of fullscreen.
guard_desktop() {
    set +e
    local id state
    while we_running || (( SECONDS < 120 )); do
        id="$(xwininfo -root -tree 2>/dev/null | awk -v t="\"$DESKTOP_TITLE\":" 'index($0, t) { print $1; exit }')"
        if [[ -n "$id" ]] && ! xprop -id "$id" _NET_WM_STATE 2>/dev/null | grep -q _NET_WM_STATE_BELOW; then
            sleep 1   # give KWin a moment to apply the rule after mapping
            state="$(xprop -id "$id" _NET_WM_STATE 2>/dev/null)"
            if [[ -n "$state" && "$state" != *_NET_WM_STATE_BELOW* ]]; then
                log "desktop window is not kept below ($state); stopping Wallpaper Engine"
                pkill -f "$WE_PROCESS"
                return
            fi
        fi
        sleep 0.5
    done
}

# Built by `make`. Windows-side paths go through Wine's Z: drive.
winpath() { printf 'Z:%s' "${1//\//\\}"; }
WELAUNCH="$ROOT/build/welaunch.exe"
AGENT="$ROOT/build/we-linux-agent"
for f in "$WELAUNCH" "$ROOT/build/weshim.dll" "$AGENT"; do
    [[ -f "$f" ]] || { log "$f is missing; run 'make' in $ROOT first."; exit 1; }
done
# launcher.exe would pick wallpaper32.exe; we always run the 64-bit build with the shim loaded.
TARGET=("$WELAUNCH" "$(winpath "$ROOT/build/weshim.dll")" "$WE_DIR/wallpaper64.exe")

[[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]] || { log "only KDE Plasma is supported for now."; exit 1; }

# Wine follows XWayland's Xcursor resources, which can lag behind the theme chosen in Plasma;
# hand it Plasma's own setting.
if [[ -z "${XCURSOR_THEME:-}" ]] && theme="$(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme 2>/dev/null)" && [[ -n "$theme" ]]; then
    export XCURSOR_THEME="$theme"
    size="$(kreadconfig6 --file kcminputrc --group Mouse --key cursorSize 2>/dev/null)"
    [[ -n "$size" ]] && export XCURSOR_SIZE="$size"
fi

# The agent relays the native window list from KWin to the shim through this file.
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/we-linux"
mkdir -p "$STATE_DIR"
export WE_LINUX_STATE="$(winpath "$STATE_DIR/windows")"
pkill -x we-linux-agent 2>/dev/null || true
"$AGENT" "$STATE_DIR/windows" &
AGENT_PID=$!

setup_kwin || { kill "$AGENT_PID"; log "cannot pin the desktop window on this session; not starting."; exit 1; }

# Runs alongside Wallpaper Engine (this script execs into it) and cleans up after it.
supervise() {
    guard_desktop
    while we_running; do sleep 2; done
    kill "$AGENT_PID" 2>/dev/null
}
supervise &

if [[ $# -gt 0 ]]; then
    # Launched by Steam with %command%: swap Wallpaper Engine's executable for our launcher.
    args=() swapped=0
    while (( $# )); do
        if (( !swapped )) && [[ "$1" =~ /wallpaper_engine/(launcher|wallpaper32|wallpaper64)\.exe$ ]]; then
            args+=("${TARGET[@]}") swapped=1
            # "-run <exe>" tells launcher.exe which build to start; we've already chosen.
            [[ "${2:-}" == -run ]] && shift 2
        else
            args+=("$1")
        fi
        shift
    done
    if (( !swapped )); then
        kill "$AGENT_PID"
        log "couldn't find Wallpaper Engine's executable in the Steam command: $*"
        exit 1
    fi
    exec "${args[@]}"
fi

# Standalone: build the same command Steam would. Steam must be running so steam_api can verify ownership.
pgrep -x steam >/dev/null || { log "Steam must be running."; exit 1; }
PROTON_DIR="$STEAM_ROOT/steamapps/common/${WE_LINUX_PROTON:-Proton - Experimental}"
RUNTIME="$STEAM_ROOT/steamapps/common/SteamLinuxRuntime_sniper/_v2-entry-point"
[[ -x "$PROTON_DIR/proton" ]] || { log "Proton not found at $PROTON_DIR"; exit 1; }

export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"
export STEAM_COMPAT_DATA_PATH="$COMPAT_DATA"
export STEAM_COMPAT_INSTALL_PATH="$WE_DIR"
export SteamAppId=$APPID SteamGameId=$APPID

cd "$WE_DIR"
exec "$RUNTIME" --verb=waitforexitandrun -- "$PROTON_DIR/proton" waitforexitandrun "${TARGET[@]}"
